# ── Database ───────────────────────────────────────────────
# Leave empty to use the built-in embedded PostgreSQL (PGlite) stored in ./.data
# For Supabase: Project Settings → Database → Connection string (URI, "Session pooler")
DATABASE_URL=

# ── Authentication ─────────────────────────────────────────
# Long random string used to sign session tokens (openssl rand -base64 48)
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# ── AI assistant (optional) ────────────────────────────────
# Without a key the assistant runs in clearly labelled DEMO MODE.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
